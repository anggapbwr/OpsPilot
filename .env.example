# OpsPilot Environment Configuration Example

APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Ollama AI Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=45.0
OLLAMA_CONNECT_TIMEOUT_SECONDS=5.0

# Target Monitored Service
TARGET_SERVICE_NAME=payment-api
TARGET_SERVICE_URL=http://payment-api:8080
TARGET_CONTAINER_NAME=payment-api

# Remediation & Policy Engine
MAX_REMEDIATION_ATTEMPTS=3
POLICY_FILE=policies/remediation.yaml
ANSIBLE_INVENTORY=ansible/inventory/hosts.yml
ANSIBLE_PLAYBOOKS_DIR=ansible/playbooks

# Audit Logging
AUDIT_LOG_FILE=logs/audit.log
